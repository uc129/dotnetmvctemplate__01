{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Properties": { "Application": "AppTemplate" }
  },
  "Database": {
    "ConnectionString": "",
    "SlowCallMilliseconds": 1000,
    "CommandTimeoutSeconds": 30
  },
  "BusinessTime": {
    "TimeZone": "Asia/Kolkata"
  },
  "AllowedHosts": "*"
}
