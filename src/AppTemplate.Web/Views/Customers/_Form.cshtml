@model CustomerFormModel
@* Shared by Create and Edit. The date input needs nothing special: DateInputTagHelper handles it. *@
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<input asp-for="RowVersion" type="hidden" />

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Email" class="form-label"></label>
    <input asp-for="Email" class="form-control" />
    <span asp-validation-for="Email" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Phone" class="form-label"></label>
    <input asp-for="Phone" class="form-control" />
    <span asp-validation-for="Phone" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="CustomerSince" class="form-label"></label>
    <input asp-for="CustomerSince" class="form-control" />
    <span asp-validation-for="CustomerSince" class="text-danger"></span>
</div>
