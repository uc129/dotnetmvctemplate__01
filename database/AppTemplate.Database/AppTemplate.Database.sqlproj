<Project Sdk="Microsoft.Build.Sql/2.3.0">
  <!--
    SDK-style SQL Database project. Every .sql file under this folder is part of the schema.
    dotnet build validates it (a procedure that names a missing column fails the build) and
    produces bin/<Configuration>/AppTemplate.Database.dacpac, which is what gets deployed.
  -->
  <PropertyGroup>
    <Name>AppTemplate.Database</Name>
    <!-- Sql160 = SQL Server 2022. Change to match the oldest server you deploy to. -->
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
  </PropertyGroup>
</Project>
