<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Real SQL Server in Docker (Testcontainers), schema deployed from the dacpac, real HTTP
    pipeline (WebApplicationFactory). Needs Docker running. Slower; CI runs them on every PR.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Microsoft.SqlServer.DacFx" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AppTemplate.Web\AppTemplate.Web.csproj" />
    <!-- Build order only: the tests deploy the dacpac this project produces. -->
    <ProjectReference Include="..\..\database\AppTemplate.Database\AppTemplate.Database.sqlproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
